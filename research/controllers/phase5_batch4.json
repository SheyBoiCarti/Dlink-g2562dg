[
  {
    "name": "data_details",
    "command": "ls -la /data; ls -ld /data/log /tmp/var /tmp/var/dropbear; ls -ld /.ssh /etc/dropbear /tmp/var/dropbear/authorized_keys /etc/dropbear/authorized_keys 2>/dev/null"
  },
  {
    "name": "key_fingerprint",
    "command": "dropbearkey -y -f /var/dropbear/rsa_host_key 2>/dev/null | awk '/Fingerprint:/{print}'"
  },
  {
    "name": "init_inventory",
    "command": "ls /etc/init.d; ls /usr/sbin | grep -E \"sysmgr|srvcmgr|tdsmgr|cfgcmd|flash|mtd|nand|dump|dropbear|utils|vsftpd\""
  },
  {
    "name": "volatile_links",
    "command": "ls -ld /etc/resolv.conf /etc/hosts /etc/mtab /etc/smbpasswd /etc/fstab /var/group /var/passwd; cat /etc/config/fstab"
  },
  {
    "name": "flash_flags",
    "command": "for n in 0 1 2 7 14; do d=/sys/class/mtd/mtd$n; ls -ld \"$d\" 2>/dev/null; done; ls /sys/class/mtd 2>/dev/null"
  },
  {
    "name": "tools",
    "command": "busybox --list | grep -E \"^(md5sum|sha1sum|sha256sum|strings|od|hexdump|stat|find|awk|nc|nanddump|flash_erase|flashcp|mtd|mount|umount)$\"; ls -l /usr/sbin/dropbear /usr/sbin/ams_cli /usr/sbin/srvcmgr /usr/sbin/sysmgr /usr/sbin/cfgcmd"
  },
  {
    "name": "firewall_summary",
    "command": "iptables -S 2>/dev/null | awk '/^-P / {print} /--dport (22|23)( |$)|-m multiport --dports [0-9,]*(22|23)/ {gsub(/--source [^ ]+/,\"--source [withheld]\"); print} /^-A INPUT / {print}'; command -v ip6tables"
  },
  {
    "name": "hosts_and_account_status",
    "command": "awk -F: '{n++; if ($3==0) z++} END {print \"passwd_records=\"n,\"uid0_records=\"z}' /etc/passwd; grep -E '^(CONFIG|START|STOP|PROG|USE_PROCD|SERVICE|[[:space:]]*service_start|[[:space:]]*start)' /etc/init.d/telnet 2>/dev/null"
  }
]
